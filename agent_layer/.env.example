# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...

# Optional: set log level
LOG_LEVEL=INFO

# Optional: set custom cycle timing (minutes)
CYCLE_MIN_SLEEP=45
CYCLE_MAX_SLEEP=75

# Optional: custom rate limiting (seconds)
SEARCH_MIN_INTERVAL=8
SEARCH_MAX_INTERVAL=12

# TLS certificate verification is on by default. Set to 1 ONLY behind a
# TLS-intercepting proxy you cannot trust properly (disables verification).
# ALLOW_INSECURE_SSL=1
